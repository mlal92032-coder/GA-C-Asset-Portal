{
  "name": "asset-management-system",
  "version": "1.0.1",
  "description": "Enterprise Employee Asset Management System - Monorepo (Frontend + Backend)",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=frontend",
    "dev:all": "concurrently \"npm run dev --workspace=frontend\" \"npm run dev --workspace=backend\"",
    "build": "npm run build --workspace=frontend && npm run build --workspace=backend",
    "start": "npm start --workspace=frontend",
    "lint": "npm run lint --workspace=frontend && npm run lint --workspace=backend",
    "test": "npm test --workspace=frontend && npm test --workspace=backend",
    "db:migrate": "npm run db:migrate --workspace=backend",
    "db:seed": "npm run db:seed --workspace=backend",
    "ws": "npm run ws --workspace=backend",
    "jobs": "npm run jobs --workspace=backend",
    "setup": "npm install && npm run db:seed --workspace=backend"
  },
  "devDependencies": {
    "concurrently": "^8.2.0"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  }
}
