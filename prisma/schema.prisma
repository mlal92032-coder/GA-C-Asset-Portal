// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  fullName      String    @map("full_name")
  email         String    @unique
  password      String    // Hashed with bcrypt
  department    String?
  designation   String?
  phone         String?
  role          Role      @default(VIEW_USER)
  status        Status    @default(ACTIVE)
  permissions   String?   @map("permissions") // JSON array of allowed modules
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  assignedFurniture   FurnitureAsset[]  @relation("AssignedUserFurniture")
  assignedElectronic  ElectronicAsset[] @relation("AssignedUserElectronic")
  assignedVehicle     VehicleAsset[]    @relation("AssignedUserVehicle")

  auditLogs     AuditLog[]
  notifications Notification[]
  checkouts     AssetCheckout[]
  reviews       Review[]
  maintenances  Maintenance[]
  deleteRequests DeleteRequest[] @relation("DeleteRequestUser")
  userCreationRequests UserCreationRequest[] @relation("UserCreationRequestUser")
  userDeleteRequests UserDeleteRequest[] @relation("UserDeleteRequestUser")
  assetAddRequests AssetAddRequest[] @relation("AssetAddRequestUser")

  // Settings & Permissions
  settingAuditLogs SettingAuditLog[] @relation("SettingsAuditUser")
  notificationPreference NotificationPreference? @relation("NotificationPref")
  permissionOverrides UserPermissionOverride[] @relation("PermissionOverrides")
  permissionsApplied UserPermissionOverride[] @relation("PermissionAppliedBy")
  profileSettings UserProfileSettings? @relation("ProfileSettings")
  systemLogs SystemLog[] @relation("SystemLogs")

  @@map("users")
}

enum Role {
  SUPER_ADMIN
  USER
  VIEW_USER
}

enum Status {
  ACTIVE
  INACTIVE
}

enum DeleteRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum UserDeleteRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum UserCreationRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum Condition {
  GOOD
  REPAIR
  DAMAGED
}

enum AssetStatus {
  IN_USE
  IN_STORE
  DISPOSED
  AUCTION
}

model Company {
  id          String   @id @default(cuid())
  companyName String   @map("company_name")
  address     String?
  phone       String?
  email       String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  
  furniture   FurnitureAsset[]
  electronic  ElectronicAsset[]
  vehicles    VehicleAsset[]

  @@map("companies")
}

model Manufacturer {
  id             String   @id @default(cuid())
  manufacturerName String @map("manufacturer_name")
  country        String?
  supportEmail   String?  @map("support_email")
  supportPhone   String?  @map("support_phone")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  
  furniture      FurnitureAsset[]
  electronic     ElectronicAsset[]
  vehicles       VehicleAsset[]

  @@map("manufacturers")
}

model Location {
  id            String   @id @default(cuid())
  locationName  String   @map("location_name")
  building      String?
  floor         String?
  room          String?
  roomType      String?  @map("room_type") // Hall, Community Room, Floor, etc.
  description   String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  furniture     FurnitureAsset[]
  electronic    ElectronicAsset[]
  vehicles      VehicleAsset[]

  @@map("locations")
}

model FurnitureAsset {
  id            String      @id @default(cuid())
  assetTag      String?     @unique @map("asset_tag")
  assetName     String      @map("asset_name")
  serialNumber  String?     @map("serial_number")
  imageUrl      String?     @map("image_url")
  qrPassword    String?     @map("qr_password")
  furnitureType String?     @map("furniture_type")
  material      String?
  purchaseDate  DateTime?   @map("purchase_date")
  purchasePrice Float?      @map("purchase_price")
  companyId     String?     @map("company_id")
  manufacturerId String?    @map("manufacturer_id")
  locationId    String?     @map("location_id")
  assignedUserId String?    @map("assigned_user_id")
  condition     Condition   @default(GOOD)
  status        AssetStatus @default(IN_STORE)
  remarks       String?
  usefulLifeYears Int?     @map("useful_life_years")
  salvageValue  Float?     @map("salvage_value")
  depreciationMethod String? @map("depreciation_method")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  company       Company?    @relation(fields: [companyId], references: [id], onDelete: SetNull)
  manufacturer  Manufacturer? @relation(fields: [manufacturerId], references: [id], onDelete: SetNull)
  location      Location?   @relation(fields: [locationId], references: [id], onDelete: SetNull)
  assignedUser  User?       @relation("AssignedUserFurniture", fields: [assignedUserId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([manufacturerId])
  @@index([locationId])
  @@index([assignedUserId])
  @@index([condition])
  @@index([status])
  @@index([createdAt])
  @@index([status, condition])
  @@index([companyId, status])
  @@index([locationId, status])
  @@map("furniture_assets")
}

model ElectronicAsset {
  id                  String      @id @default(cuid())
  assetTag            String?     @unique @map("asset_tag")
  assetName           String      @map("asset_name")
  imageUrl            String?     @map("image_url")
  qrPassword          String?     @map("qr_password")
  deviceType          String?     @map("device_type")
  brand               String?
  model               String?
  serialNumber        String?     @unique @map("serial_number")
  purchaseDate        DateTime?   @map("purchase_date")
  warrantyEndDate     DateTime?   @map("warranty_end_date")
  companyId           String?     @map("company_id")
  manufacturerId      String?     @map("manufacturer_id")
  locationId          String?     @map("location_id")
  assignedUserId      String?     @map("assigned_user_id")
  condition           Condition   @default(GOOD)
  status              AssetStatus @default(IN_STORE)
  lastMaintenanceDate DateTime?   @map("last_maintenance_date")
  remarks             String?
  usefulLifeYears     Int?       @map("useful_life_years")
  salvageValue        Float?     @map("salvage_value")
  depreciationMethod  String?    @map("depreciation_method")
  createdAt           DateTime    @default(now()) @map("created_at")
  updatedAt           DateTime    @updatedAt @map("updated_at")

  company             Company?    @relation(fields: [companyId], references: [id], onDelete: SetNull)
  manufacturer        Manufacturer? @relation(fields: [manufacturerId], references: [id], onDelete: SetNull)
  location            Location?   @relation(fields: [locationId], references: [id], onDelete: SetNull)
  assignedUser        User?       @relation("AssignedUserElectronic", fields: [assignedUserId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([manufacturerId])
  @@index([locationId])
  @@index([assignedUserId])
  @@index([condition])
  @@index([status])
  @@index([createdAt])
  @@index([status, condition])
  @@index([companyId, status])
  @@index([locationId, status])
  @@map("electronic_assets")
}

model VehicleAsset {
  id                  String      @id @default(cuid())
  assetTag            String?     @unique @map("asset_tag")
  assetName           String      @map("asset_name")
  serialNumber        String?     @map("serial_number")
  imageUrl            String?     @map("image_url")
  qrPassword          String?     @map("qr_password")
  vehicleType         String?     @map("vehicle_type")
  brand               String?
  model               String?
  registrationNumber  String      @unique @map("registration_number")
  engineNumber        String?     @map("engine_number")
  chassisNumber       String?     @map("chassis_number")
  fuelType            String?     @map("fuel_type")
  purchaseDate        DateTime?   @map("purchase_date")
  purchasePrice       Float?      @map("purchase_price")
  companyId           String?     @map("company_id")
  manufacturerId      String?     @map("manufacturer_id")
  locationId          String?     @map("location_id")
  assignedUserId      String?     @map("assigned_user_id")
  condition           Condition   @default(GOOD)
  status              AssetStatus @default(IN_STORE)
  lastServiceDate     DateTime?   @map("last_service_date")
  insuranceExpiryDate DateTime?   @map("insurance_expiry_date")
  remarks             String?
  usefulLifeYears     Int?       @map("useful_life_years")
  salvageValue        Float?     @map("salvage_value")
  depreciationMethod  String?    @map("depreciation_method")
  createdAt           DateTime    @default(now()) @map("created_at")
  updatedAt           DateTime    @updatedAt @map("updated_at")

  company             Company?    @relation(fields: [companyId], references: [id], onDelete: SetNull)
  manufacturer        Manufacturer? @relation(fields: [manufacturerId], references: [id], onDelete: SetNull)
  location            Location?   @relation(fields: [locationId], references: [id], onDelete: SetNull)
  assignedUser        User?       @relation("AssignedUserVehicle", fields: [assignedUserId], references: [id], onDelete: SetNull)
  spareParts          SparePart[] @relation()

  @@index([companyId])
  @@index([manufacturerId])
  @@index([locationId])
  @@index([assignedUserId])
  @@index([condition])
  @@index([status])
  @@index([createdAt])
  @@index([status, condition])
  @@index([companyId, status])
  @@index([locationId, status])
  @@map("vehicle_assets")
}

model AssetCheckout {
  id                  String   @id @default(cuid())
  assetId             String   @map("asset_id")
  assetType           String   @map("asset_type") // FURNITURE, ELECTRONIC, VEHICLE
  userId              String   @map("user_id") // Who the asset is checked out to
  checkedOutBy        String   @map("checked_out_by") // User who performed checkout
  checkedOutAt        DateTime @default(now()) @map("checked_out_at")
  expectedReturnDate  DateTime? @map("expected_return_date")
  checkInDate         DateTime? @map("check_in_date")
  checkedInBy         String?  @map("checked_in_by")
  checkoutNotes       String?  @map("checkout_notes")
  checkinNotes        String?  @map("checkin_notes")
  condition           String?  // Condition at checkout
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@index([userId])
  @@index([checkedOutBy])
  @@index([assetType])
  @@index([checkedOutAt])
  @@index([checkInDate])
  @@index([expectedReturnDate, checkInDate])
  @@map("asset_checkouts")
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  action      String   // CREATE, UPDATE, DELETE, LOGIN, LOGOUT
  entity      String   // USER, COMPANY, FURNITURE, ELECTRONIC, VEHICLE, LOCATION, MANUFACTURER
  entityId    String?  @map("entity_id")
  details     String?  // JSON string of changes
  createdAt   DateTime @default(now()) @map("created_at")

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("audit_logs")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  title     String
  message   String
  type      String   @default("INFO") // WARNING, INFO, SUCCESS, ERROR
  isRead    Boolean  @default(false)
  link      String?  // Clickable link (e.g., /assets/electronics/abc123)
  metadata  String?  // JSON string for additional data
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}

model Attachment {
  id        String   @id @default(cuid())
  assetId   String   @map("asset_id")
  assetType String   @map("asset_type") // FURNITURE, ELECTRONIC, VEHICLE
  fileName  String   @map("file_name")
  filePath  String   @map("file_path")
  fileSize  Int      @map("file_size")
  fileType  String   @map("file_type")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([assetId])
  @@index([assetType])
  @@map("attachments")
}

model Review {
  id        String   @id @default(cuid())
  assetId   String   @map("asset_id")
  assetType String   @map("asset_type") // FURNITURE, ELECTRONIC, VEHICLE
  userId    String   @map("user_id")
  rating    Int      // 1-5 stars
  comment   String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@index([assetType])
  @@index([userId])
  @@index([rating])
  @@index([createdAt])
  @@map("reviews")
}

model Maintenance {
  id              String   @id @default(cuid())
  assetId         String   @map("asset_id")
  assetType       String   @map("asset_type") // FURNITURE, ELECTRONIC, VEHICLE
  userId          String?  @map("user_id")
  maintenanceDate DateTime @default(now()) @map("maintenance_date")
  description     String
  cost            Float?
  performedBy     String?  @map("performed_by")
  nextDueDate     DateTime? @map("next_due_date")
  status          MaintenanceStatus @default(SCHEDULED)
  odometerReading Int?     @map("odometer_reading") // For vehicles
  workType        String?  @map("work_type") // Oil Change, Repair, Service, Inspection, etc.
  vendorName      String?  @map("vendor_name")
  paymentMethod   String?  @map("payment_method") // Cash, Bank Transfer, Card
  remarks         String?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([assetId])
  @@index([assetType])
  @@index([maintenanceDate])
  @@index([status])
  @@index([userId])
  @@map("maintenances")
}

model SparePart {
  id              String   @id @default(cuid())
  partDate        DateTime @default(now()) @map("part_date")
  partName        String   @map("part_name")
  quantity        Int
  unitPrice       Float    @map("unit_price") // Price in PKR
  totalCost       Float    @map("total_cost") // Auto-calculated: quantity × unitPrice
  supplierName    String   @map("supplier_name")
  vehicleId       String?  @map("vehicle_id") // Optional: linked to specific vehicle
  remarks         String?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  vehicle         VehicleAsset? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  @@index([partDate])
  @@index([vehicleId])
  @@index([createdAt])
  @@map("spare_parts")
}

enum MaintenanceStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model DeleteRequest {
  id              String   @id @default(cuid())
  assetId         String   @map("asset_id")
  assetType       String   @map("asset_type") // FURNITURE, ELECTRONIC, VEHICLE
  assetName       String   @map("asset_name")
  requestedById   String   @map("requested_by_id")
  reason          String?
  status          DeleteRequestStatus @default(PENDING)
  reviewedById    String?  @map("reviewed_by_id")
  reviewNotes     String?  @map("review_notes")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  requestedBy     User     @relation("DeleteRequestUser", fields: [requestedById], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@index([assetType])
  @@index([status])
  @@index([requestedById])
  @@index([createdAt])
  @@map("delete_requests")
}

model UserCreationRequest {
  id              String   @id @default(cuid())
  fullName        String   @map("full_name")
  email           String   @unique
  role            Role     @default(VIEW_USER)
  department      String?
  designation     String?
  phone           String?
  requestedById   String   @map("requested_by_id")
  reason          String?
  status          UserCreationRequestStatus @default(PENDING)
  reviewedById    String?  @map("reviewed_by_id")
  reviewNotes     String?  @map("review_notes")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  requestedBy     User     @relation("UserCreationRequestUser", fields: [requestedById], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([status])
  @@index([requestedById])
  @@index([createdAt])
  @@map("user_creation_requests")
}

model UserDeleteRequest {
  id              String   @id @default(cuid())
  userId          String   @map("user_id")
  userName        String   @map("user_name")
  userEmail       String   @map("user_email")
  requestedById   String   @map("requested_by_id")
  reason          String?
  status          UserDeleteRequestStatus @default(PENDING)
  reviewedById    String?  @map("reviewed_by_id")
  reviewNotes     String?  @map("review_notes")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  requestedBy     User     @relation("UserDeleteRequestUser", fields: [requestedById], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([requestedById])
  @@index([createdAt])
  @@map("user_delete_requests")
}

model AssetAddRequest {
  id              String   @id @default(cuid())
  assetType       String   @map("asset_type")
  assetData       String   // JSON string of asset data
  requestedById   String   @map("requested_by_id")
  status          String   @default("PENDING")
  reviewedById    String?  @map("reviewed_by_id")
  reviewNotes     String?  @map("review_notes")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  requestedBy     User     @relation("AssetAddRequestUser", fields: [requestedById], references: [id], onDelete: Cascade)

  @@index([assetType])
  @@index([status])
  @@index([requestedById])
  @@index([createdAt])
  @@map("asset_add_requests")
}

// ============= UNIFIED SETTINGS SYSTEM =============

model SettingCategory {
  id            String   @id @default(cuid())
  name          String   @unique
  slug          String   @unique
  description   String?
  icon          String   // Icon name from lucide-react
  color         String   // text color class
  bgColor       String   // background gradient class
  order         Int      @default(0)
  isSystem      Boolean  @default(false) // Cannot be deleted if true
  requiredRole  Role     @default(SUPER_ADMIN) // Minimum role to access
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  settings      SystemSetting[]

  @@map("setting_categories")
}

model SystemSetting {
  id              String   @id @default(cuid())
  categoryId      String   @map("category_id")
  category        SettingCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  key             String   // e.g., "organizationName"
  displayName     String   // e.g., "Organization Name"
  description     String?
  value           String?  // Stored as JSON for complex types
  dataType        String   @default("string") // string, number, boolean, json, email, url
  fieldType       String   @default("text") // text, textarea, number, email, color, select, checkbox, date, time, phone, url
  validation      String?  // e.g., "required, email"
  options         String?  // For select/radio: JSON array
  placeholder     String?
  helpText        String?
  isEncrypted     Boolean  @default(false) // For passwords, API keys
  isRequired      Boolean  @default(false)
  order           Int      @default(0)
  isActive        Boolean  @default(true)
  isVisible       Boolean  @default(true) // Can be hidden from UI

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  auditLogs       SettingAuditLog[]

  @@unique([categoryId, key])
  @@map("system_settings")
}

model SettingAuditLog {
  id              String   @id @default(cuid())
  userId          String   @map("user_id")
  user            User     @relation("SettingsAuditUser", fields: [userId], references: [id], onDelete: Cascade)

  settingId       String   @map("setting_id")
  setting         SystemSetting @relation(fields: [settingId], references: [id], onDelete: Cascade)

  categoryName    String
  fieldName       String
  oldValue        String?
  newValue        String?
  changeReason    String?
  ipAddress       String?
  userAgent       String?

  createdAt       DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([settingId])
  @@index([createdAt])
  @@map("setting_audit_logs")
}

model SecurityPolicy {
  id                      String   @id @default(cuid())

  // Authentication
  sessionTimeoutMinutes   Int      @default(30)
  maxLoginAttempts        Int      @default(5)
  lockoutDurationMinutes  Int      @default(15)
  passwordExpiryDays      Int      @default(90)
  passwordHistoryCount    Int      @default(5) // Can't reuse last N passwords
  minPasswordLength       Int      @default(8)
  requirePasswordUppercase Boolean @default(true)
  requirePasswordNumbers   Boolean @default(true)
  requirePasswordSpecial   Boolean @default(true)
  require2FA              Boolean @default(false)
  allow2FABypass          Boolean @default(false) // Recovery codes

  // IP Restrictions
  enableIPRestriction     Boolean @default(false)
  allowedIPs              String?  // JSON array of IPs

  // API Settings
  enableAPIAccess         Boolean @default(true)
  apiRateLimitPerMinute   Int     @default(100)
  apiKeyRotationDays      Int     @default(90)

  // Audit & Logging
  enableAuditLogging      Boolean @default(true)
  logSensitiveActions     Boolean @default(true)
  auditLogRetentionDays   Int     @default(365)

  // Data Privacy
  enableGDPRMode          Boolean @default(true)
  dataRetentionYears      Int     @default(7)
  autoDeleteOldRecords    Boolean @default(false)
  encryptSensitiveFields  Boolean @default(true)

  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  @@map("security_policies")
}

model NotificationPreference {
  id                      String   @id @default(cuid())
  userId                  String?  @unique @map("user_id")
  user                    User?    @relation("NotificationPref", fields: [userId], references: [id], onDelete: Cascade)

  // Email Settings
  emailNotificationsEnabled  Boolean @default(true)
  emailAddress            String?
  emailFrequency          String   @default("REALTIME") // REALTIME, DAILY, WEEKLY

  // In-App Settings
  inAppNotificationsEnabled  Boolean @default(true)
  soundEnabled            Boolean @default(true) // Bell sound ✓
  soundVolume             Int     @default(50) // 0-100
  desktopNotificationsEnabled Boolean @default(true)

  // Alert Types (JSON)
  alertTypes              String?  // {"assetAdded": true, "checkout": true, ...}

  // Thresholds
  maintenanceAlertDays    Int     @default(7)
  warrantyAlertDays       Int     @default(30)
  stockLevelAlertThreshold Int    @default(10)
  budgetVarianceAlertPercent Int  @default(10)
  overdueCheckoutAlertDays Int    @default(3)

  // Quiet Hours
  quietHoursEnabled       Boolean @default(false)
  quietHoursStart         String? // "18:00"
  quietHoursEnd           String? // "09:00"

  // Notification Retention
  retentionDays           Int     @default(30)
  autoDeleteNotifications Boolean @default(true)

  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  @@map("notification_preferences")
}

model RolePermission {
  id              String   @id @default(cuid())
  role            Role
  module          String   // dashboard, furniture, electronics, vehicles, users, reports, settings, audit_logs
  action          String   // view, create, edit, delete, export, import, approve, reject, checkout, checkin
  isAllowed       Boolean  @default(true)

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([role, module, action])
  @@map("role_permissions")
}

model UserPermissionOverride {
  id              String   @id @default(cuid())
  userId          String   @map("user_id")
  user            User     @relation("PermissionOverrides", fields: [userId], references: [id], onDelete: Cascade)

  module          String   // Module name
  action          String   // Action name
  isAllowed       Boolean  @default(true) // Override to allow/deny

  validFrom       DateTime @default(now()) @map("valid_from")
  validUntil      DateTime? @map("valid_until")
  reason          String?

  appliedBy       String   @map("applied_by")
  appliedByUser   User     @relation("PermissionAppliedBy", fields: [appliedBy], references: [id], onDelete: Restrict)

  createdAt       DateTime @default(now()) @map("created_at")

  @@unique([userId, module, action])
  @@index([userId])
  @@index([validFrom, validUntil])
  @@map("user_permission_overrides")
}

model OrganizationInfo {
  id              String   @id @default(cuid())

  organizationName String
  organizationLogo String?
  organizationBanner String?
  address         String?
  city            String?
  country         String?
  postalCode      String?

  phone           String?
  email           String?
  website         String?
  registrationNumber String?
  taxNumber       String?

  // Branding
  primaryColor    String  @default("#2563eb") // Hex color
  secondaryColor  String  @default("#1e40af")
  accentColor     String  @default("#f97316")

  // Regional Settings
  timezone        String  @default("Asia/Karachi")
  language        String  @default("en") // en, ur
  dateFormat      String  @default("DD/MM/YYYY")
  timeFormat      String  @default("24h") // 24h, 12h
  currency        String  @default("PKR")
  currencySymbol  String  @default("₨")

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("organization_info")
}

model AssetDefaults {
  id              String   @id @default(cuid())

  assetTagPrefix  String  @default("SEF-")
  autoGenerateTags Boolean @default(true)
  defaultCondition String  @default("GOOD") // GOOD, REPAIR, DAMAGED
  defaultStatus   String  @default("IN_STORE") // IN_USE, IN_STORE, DISPOSED, AUCTION

  defaultDepreciationMethod String @default("STRAIGHT_LINE") // STRAIGHT_LINE, DECLINING_BALANCE, UNITS_OF_PRODUCTION
  defaultUsefulLife Int     @default(5) // years
  salvageValuePercent Int   @default(10) // %

  enableQRCodes   Boolean @default(true)
  enableBarcodes  Boolean @default(false)
  enableSerialNumbers Boolean @default(true)

  stockReorderLevel Int     @default(5)
  itemsPerPage    Int     @default(25)

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("asset_defaults")
}

model ReportConfiguration {
  id              String   @id @default(cuid())

  reportName      String
  reportType      String   // inventory, depreciation, activity, checkout, maintenance, budget, condition, location, department
  description     String?

  schedule        String?  // DAILY, WEEKLY, MONTHLY or cron expression
  isScheduled     Boolean  @default(false)
  lastRunAt       DateTime?
  nextRunAt       DateTime?

  format          String  @default("PDF") // PDF, EXCEL, CSV, JSON

  recipients      String?  // JSON array of emails
  includeCharts   Boolean @default(true)
  includeSummary  Boolean @default(true)
  dataRange       Int     @default(30) // days

  isActive        Boolean @default(true)

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("report_configurations")
}

model SystemLog {
  id              String   @id @default(cuid())

  userId          String?  @map("user_id")
  user            User?    @relation("SystemLogs", fields: [userId], references: [id], onDelete: SetNull)

  actionType      String   // LOGIN, LOGOUT, CREATE, UPDATE, DELETE, EXPORT, IMPORT, APPROVE, REJECT, DOWNLOAD, UPLOAD
  module          String
  entityId        String?
  entityType      String?

  status          String  @default("SUCCESS") // SUCCESS, ERROR, PENDING
  message         String?
  details         String? // JSON

  ipAddress       String?
  userAgent       String?

  createdAt       DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([actionType])
  @@index([createdAt])
  @@map("system_logs")
}

// Update User model to add new relations
model UserProfileSettings {
  id              String   @id @default(cuid())
  userId          String   @unique @map("user_id")
  user            User     @relation("ProfileSettings", fields: [userId], references: [id], onDelete: Cascade)

  theme           String  @default("light") // light, dark, auto
  language        String  @default("en")
  timezone        String?
  dateFormat      String?

  profilePhoto    String?
  bio             String?
  signature       String?

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("user_profile_settings")
}
