// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============= MULTI-TENANCY FOUNDATION =============

model Tenant {
  id                    String    @id @default(cuid())
  name                  String    // "Acme Inc", "TechCo"
  slug                  String    @unique // "acme-inc", "techco" - used in subdomains
  domain                String?   @unique // Optional: custom domain like "assets.acmeinc.com"
  status                String    @default("ACTIVE") // ACTIVE, SUSPENDED, DELETED
  tier                  String    @default("STANDARD") // FREE, STARTER, PROFESSIONAL, ENTERPRISE

  // Billing
  billingEmail          String
  billingPhone          String?
  billingAddress        String?
  taxId                 String?   @map("tax_id")

  // Usage Tracking (updated monthly)
  monthlyUsageStorage   BigInt    @default(0) @map("monthly_usage_storage") // bytes
  monthlyAPICallsCount  Int       @default(0) @map("monthly_api_calls_count")
  monthlyUserCount      Int       @default(0) @map("monthly_user_count")

  // Limits & Quotas
  storageQuotaGB        Int       @default(10) @map("storage_quota_gb") // GB
  maxAPICallsPerMonth   Int       @default(100000) @map("max_api_calls_per_month")
  maxUsers              Int       @default(50) @map("max_users")
  maxAssets             Int       @default(5000) @map("max_assets")

  // Features
  enabledFeatures       String    @default("[]") @map("enabled_features") // JSON array of enabled features
  customBranding       Boolean   @default(false) @map("custom_branding")

  // Timestamps
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  deletedAt             DateTime? @map("deleted_at") // Soft delete

  // Relations
  users                 User[]
  companies             Company[]
  manufacturers         Manufacturer[]
  locations             Location[]
  furnitureAssets       FurnitureAsset[]
  electronicAssets      ElectronicAsset[]
  vehicleAssets         VehicleAsset[]
  customRoles           CustomRole[]
  checkouts             AssetCheckout[]
  audits                AuditLog[]
  notifications         Notification[]
  settings              SystemSetting[]
  settingCategories     SettingCategory[]
  securityPolicies      SecurityPolicy[]
  notificationPrefs     NotificationPreference[]
  userPermissions       UserPermissionOverride[]
  reportConfigs         ReportConfiguration[]
  assetDefaults         AssetDefaults[]
  organizationInfos     OrganizationInfo[]
  usageMetrics          UsageMetric[]
  billingRecords        BillingRecord[]
  reviews               Review[]
  maintenances          Maintenance[]
  spareParts            SparePart[]
  deleteRequests        DeleteRequest[]
  userCreationRequests  UserCreationRequest[]
  userDeleteRequests    UserDeleteRequest[]
  assetAddRequests      AssetAddRequest[]
  systemLogs            SystemLog[]

  @@index([slug])
  @@index([status])
  @@index([tier])
  @@index([createdAt])
  @@map("tenants")
}

// ============= USAGE METRICS & BILLING =============

model UsageMetric {
  id          String    @id @default(cuid())
  tenantId    String    @map("tenant_id")
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  date        DateTime
  metricType  String    // API_CALLS, STORAGE, USERS, ASSETS
  count       Int       @default(0)
  metadata    String?   // JSON for additional context

  createdAt   DateTime  @default(now()) @map("created_at")

  @@unique([tenantId, date, metricType])
  @@index([tenantId])
  @@index([date])
  @@index([metricType])
  @@map("usage_metrics")
}

model BillingRecord {
  id                  String    @id @default(cuid())
  tenantId            String    @map("tenant_id")
  tenant              Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  billingPeriodStart  DateTime  @map("billing_period_start")
  billingPeriodEnd    DateTime  @map("billing_period_end")

  totalAmount         Float

  basePrice           Float     @default(0)
  apiCallsCharge      Float     @default(0) @map("api_calls_charge")
  storageCharge       Float     @default(0) @map("storage_charge")
  userCharge          Float     @default(0) @map("user_charge")

  status              String    @default("PENDING") // PENDING, PAID, OVERDUE, CANCELLED
  invoiceUrl          String?   @map("invoice_url")
  paidAt              DateTime? @map("paid_at")

  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  @@unique([tenantId, billingPeriodStart])
  @@index([tenantId])
  @@index([billingPeriodStart])
  @@index([status])
  @@map("billing_records")
}

// ============= END MULTI-TENANCY =============

model User {
  id            String    @id @default(cuid())
  tenantId      String    @map("tenant_id")
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  fullName      String    @map("full_name")
  email         String
  password      String    // Hashed with bcrypt
  department    String?
  designation   String?
  phone         String?
  role          String    @default("VIEW_USER")
  customRoleId  String?   @map("custom_role_id")
  customRole    CustomRole? @relation(fields: [customRoleId], references: [id], onDelete: SetNull)
  status        String    @default("ACTIVE")
  permissions   String?   @map("permissions") // JSON array of allowed modules
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  assignedFurniture   FurnitureAsset[]  @relation("AssignedUserFurniture")
  assignedElectronic  ElectronicAsset[] @relation("AssignedUserElectronic")
  assignedVehicle     VehicleAsset[]    @relation("AssignedUserVehicle")

  auditLogs     AuditLog[]
  notifications Notification[]
  checkouts     AssetCheckout[]
  reviews       Review[]
  maintenances  Maintenance[]
  deleteRequests DeleteRequest[] @relation("DeleteRequestUser")
  userCreationRequests UserCreationRequest[] @relation("UserCreationRequestUser")
  userDeleteRequests UserDeleteRequest[] @relation("UserDeleteRequestUser")
  assetAddRequests AssetAddRequest[] @relation("AssetAddRequestUser")

  // Settings & Permissions
  settingAuditLogs SettingAuditLog[] @relation("SettingsAuditUser")
  notificationPreference NotificationPreference? @relation("NotificationPref")
  permissionOverrides UserPermissionOverride[] @relation("PermissionOverrides")
  permissionsApplied UserPermissionOverride[] @relation("PermissionAppliedBy")
  profileSettings UserProfileSettings? @relation("ProfileSettings")
  systemLogs SystemLog[] @relation("SystemLogs")
  createdRoles  CustomRole[] @relation("RoleCreator")

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([customRoleId])
  @@index([status])
  @@map("users")
}

model CustomRole {
  id            String    @id @default(cuid())
  tenantId      String    @map("tenant_id")
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name          String
  description   String?
  permissions   String    // JSON array of permission strings
  isActive      Boolean   @default(true)
  createdById   String    @map("created_by_id")
  createdBy     User      @relation("RoleCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  users         User[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([createdById])
  @@map("custom_roles")
}

model Company {
  id            String   @id @default(cuid())
  tenantId      String?  @map("tenant_id")
  tenant        Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  companyName   String   @map("company_name")
  address       String?
  phone         String?
  email         String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  furniture     FurnitureAsset[]
  electronic    ElectronicAsset[]
  vehicles      VehicleAsset[]

  @@index([tenantId])
  @@map("companies")
}

model Manufacturer {
  id               String   @id @default(cuid())
  tenantId         String   @map("tenant_id")
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  manufacturerName String   @map("manufacturer_name")
  country          String?
  supportEmail     String?  @map("support_email")
  supportPhone     String?  @map("support_phone")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  furniture        FurnitureAsset[]
  electronic       ElectronicAsset[]
  vehicles         VehicleAsset[]

  @@unique([tenantId, manufacturerName])
  @@index([tenantId])
  @@map("manufacturers")
}

model Location {
  id            String   @id @default(cuid())
  tenantId      String?  @map("tenant_id")
  tenant        Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  locationName  String   @map("location_name")
  building      String?
  floor         String?
  room          String?
  roomType      String?  @map("room_type") // Hall, Community Room, Floor, etc.
  description   String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  furniture     FurnitureAsset[]
  electronic    ElectronicAsset[]
  vehicles      VehicleAsset[]

  @@unique([tenantId, locationName])
  @@index([tenantId])
  @@map("locations")
}

model FurnitureAsset {
  id            String      @id @default(cuid())
  tenantId      String      @map("tenant_id")
  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  assetTag      String?     @map("asset_tag")
  assetName     String      @map("asset_name")
  serialNumber  String?     @map("serial_number")
  imageUrl      String?     @map("image_url")
  qrPassword    String?     @map("qr_password")
  furnitureType String?     @map("furniture_type")
  material      String?
  purchaseDate  DateTime?   @map("purchase_date")
  purchasePrice Float?      @map("purchase_price")
  companyId     String?     @map("company_id")
  manufacturerId String?    @map("manufacturer_id")
  locationId    String?     @map("location_id")
  assignedUserId String?    @map("assigned_user_id")
  condition     String   @default("GOOD")
  status        String @default("IN_STORE")
  remarks       String?
  usefulLifeYears Int?     @map("useful_life_years")
  salvageValue  Float?     @map("salvage_value")
  depreciationMethod String? @map("depreciation_method")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  company       Company?    @relation(fields: [companyId], references: [id], onDelete: SetNull)
  manufacturer  Manufacturer? @relation(fields: [manufacturerId], references: [id], onDelete: SetNull)
  location      Location?   @relation(fields: [locationId], references: [id], onDelete: SetNull)
  assignedUser  User?       @relation("AssignedUserFurniture", fields: [assignedUserId], references: [id], onDelete: SetNull)

  @@unique([tenantId, assetTag])
  @@index([tenantId])
  @@index([companyId])
  @@index([manufacturerId])
  @@index([locationId])
  @@index([assignedUserId])
  @@index([condition])
  @@index([status])
  @@index([createdAt])
  @@index([tenantId, status, condition])
  @@index([tenantId, companyId, status])
  @@index([tenantId, locationId, status])
  @@map("furniture_assets")
}

model ElectronicAsset {
  id                  String      @id @default(cuid())
  tenantId            String      @map("tenant_id")
  tenant              Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  assetTag            String?     @map("asset_tag")
  assetName           String      @map("asset_name")
  imageUrl            String?     @map("image_url")
  qrPassword          String?     @map("qr_password")
  deviceType          String?     @map("device_type")
  brand               String?
  model               String?
  serialNumber        String?     @map("serial_number")
  purchaseDate        DateTime?   @map("purchase_date")
  warrantyEndDate     DateTime?   @map("warranty_end_date")
  companyId           String?     @map("company_id")
  manufacturerId      String?     @map("manufacturer_id")
  locationId          String?     @map("location_id")
  assignedUserId      String?     @map("assigned_user_id")
  condition           String   @default("GOOD")
  status              String @default("IN_STORE")
  lastMaintenanceDate DateTime?   @map("last_maintenance_date")
  remarks             String?
  usefulLifeYears     Int?       @map("useful_life_years")
  salvageValue        Float?     @map("salvage_value")
  depreciationMethod  String?    @map("depreciation_method")
  createdAt           DateTime    @default(now()) @map("created_at")
  updatedAt           DateTime    @updatedAt @map("updated_at")

  company             Company?    @relation(fields: [companyId], references: [id], onDelete: SetNull)
  manufacturer        Manufacturer? @relation(fields: [manufacturerId], references: [id], onDelete: SetNull)
  location            Location?   @relation(fields: [locationId], references: [id], onDelete: SetNull)
  assignedUser        User?       @relation("AssignedUserElectronic", fields: [assignedUserId], references: [id], onDelete: SetNull)

  @@unique([tenantId, assetTag])
  @@unique([tenantId, serialNumber])
  @@index([tenantId])
  @@index([companyId])
  @@index([manufacturerId])
  @@index([locationId])
  @@index([assignedUserId])
  @@index([condition])
  @@index([status])
  @@index([createdAt])
  @@index([tenantId, status, condition])
  @@index([tenantId, companyId, status])
  @@index([tenantId, locationId, status])
  @@map("electronic_assets")
}

model VehicleAsset {
  id                  String      @id @default(cuid())
  tenantId            String      @map("tenant_id")
  tenant              Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  assetTag            String?     @map("asset_tag")
  assetName           String      @map("asset_name")
  serialNumber        String?     @map("serial_number")
  imageUrl            String?     @map("image_url")
  qrPassword          String?     @map("qr_password")
  vehicleType         String?     @map("vehicle_type")
  brand               String?
  model               String?
  registrationNumber  String      @map("registration_number")
  engineNumber        String?     @map("engine_number")
  chassisNumber       String?     @map("chassis_number")
  fuelType            String?     @map("fuel_type")
  purchaseDate        DateTime?   @map("purchase_date")
  purchasePrice       Float?      @map("purchase_price")
  companyId           String?     @map("company_id")
  manufacturerId      String?     @map("manufacturer_id")
  locationId          String?     @map("location_id")
  assignedUserId      String?     @map("assigned_user_id")
  condition           String   @default("GOOD")
  status              String @default("IN_STORE")
  lastServiceDate     DateTime?   @map("last_service_date")
  insuranceExpiryDate DateTime?   @map("insurance_expiry_date")
  remarks             String?
  usefulLifeYears     Int?       @map("useful_life_years")
  salvageValue        Float?     @map("salvage_value")
  depreciationMethod  String?    @map("depreciation_method")
  createdAt           DateTime    @default(now()) @map("created_at")
  updatedAt           DateTime    @updatedAt @map("updated_at")

  company             Company?    @relation(fields: [companyId], references: [id], onDelete: SetNull)
  manufacturer        Manufacturer? @relation(fields: [manufacturerId], references: [id], onDelete: SetNull)
  location            Location?   @relation(fields: [locationId], references: [id], onDelete: SetNull)
  assignedUser        User?       @relation("AssignedUserVehicle", fields: [assignedUserId], references: [id], onDelete: SetNull)
  spareParts          SparePart[] @relation()

  @@unique([tenantId, assetTag])
  @@unique([tenantId, registrationNumber])
  @@index([tenantId])
  @@index([companyId])
  @@index([manufacturerId])
  @@index([locationId])
  @@index([assignedUserId])
  @@index([condition])
  @@index([status])
  @@index([createdAt])
  @@index([tenantId, status, condition])
  @@index([tenantId, companyId, status])
  @@index([tenantId, locationId, status])
  @@map("vehicle_assets")
}

model AssetCheckout {
  id                  String   @id @default(cuid())
  tenantId            String?  @map("tenant_id")
  tenant              Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  assetId             String   @map("asset_id")
  assetType           String   @map("asset_type") // FURNITURE, ELECTRONIC, VEHICLE
  userId              String   @map("user_id") // Who the asset is checked out to
  checkedOutBy        String   @map("checked_out_by") // User who performed checkout
  checkedOutAt        DateTime @default(now()) @map("checked_out_at")
  expectedReturnDate  DateTime? @map("expected_return_date")
  checkInDate         DateTime? @map("check_in_date")
  checkedInBy         String?  @map("checked_in_by")
  checkoutNotes       String?  @map("checkout_notes")
  checkinNotes        String?  @map("checkin_notes")
  condition           String?  // Condition at checkout
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([assetId])
  @@index([userId])
  @@index([checkedOutBy])
  @@index([assetType])
  @@index([checkedOutAt])
  @@index([checkInDate])
  @@index([tenantId, expectedReturnDate, checkInDate])
  @@map("asset_checkouts")
}

model AuditLog {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  userId      String   @map("user_id")
  action      String   // CREATE, UPDATE, DELETE, LOGIN, LOGOUT
  entity      String   // USER, COMPANY, FURNITURE, ELECTRONIC, VEHICLE, LOCATION, MANUFACTURER
  entityId    String?  @map("entity_id")
  details     String?  // JSON string of changes
  createdAt   DateTime @default(now()) @map("created_at")

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model Notification {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  userId    String   @map("user_id")
  title     String
  message   String
  type      String   @default("INFO") // WARNING, INFO, SUCCESS, ERROR
  isRead    Boolean  @default(false)
  link      String?  // Clickable link (e.g., /assets/electronics/abc123)
  metadata  String?  // JSON string for additional data
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}

model Attachment {
  id        String   @id @default(cuid())
  assetId   String   @map("asset_id")
  assetType String   @map("asset_type") // FURNITURE, ELECTRONIC, VEHICLE
  fileName  String   @map("file_name")
  filePath  String   @map("file_path")
  fileSize  Int      @map("file_size")
  fileType  String   @map("file_type")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([assetId])
  @@index([assetType])
  @@map("attachments")
}

model Review {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  assetId   String   @map("asset_id")
  assetType String   @map("asset_type") // FURNITURE, ELECTRONIC, VEHICLE
  userId    String   @map("user_id")
  rating    Int      // 1-5 stars
  comment   String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([assetId])
  @@index([assetType])
  @@index([userId])
  @@index([rating])
  @@index([createdAt])
  @@map("reviews")
}

model Maintenance {
  id              String   @id @default(cuid())
  tenantId        String?  @map("tenant_id")
  tenant          Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  assetId         String   @map("asset_id")
  assetType       String   @map("asset_type") // FURNITURE, ELECTRONIC, VEHICLE
  userId          String?  @map("user_id")
  maintenanceDate DateTime @default(now()) @map("maintenance_date")
  description     String
  cost            Float?
  performedBy     String?  @map("performed_by")
  nextDueDate     DateTime? @map("next_due_date")
  status          String @default("SCHEDULED")
  odometerReading Int?     @map("odometer_reading") // For vehicles
  workType        String?  @map("work_type") // Oil Change, Repair, Service, Inspection, etc.
  vendorName      String?  @map("vendor_name")
  paymentMethod   String?  @map("payment_method") // Cash, Bank Transfer, Card
  remarks         String?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([assetId])
  @@index([assetType])
  @@index([maintenanceDate])
  @@index([status])
  @@index([userId])
  @@map("maintenances")
}

model SparePart {
  id              String   @id @default(cuid())
  tenantId        String?  @map("tenant_id")
  tenant          Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  partDate        DateTime @default(now()) @map("part_date")
  partName        String   @map("part_name")
  quantity        Int
  unitPrice       Float    @map("unit_price") // Price in PKR
  totalCost       Float    @map("total_cost") // Auto-calculated: quantity × unitPrice
  supplierName    String   @map("supplier_name")
  vehicleId       String?  @map("vehicle_id") // Optional: linked to specific vehicle
  remarks         String?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  vehicle         VehicleAsset? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([partDate])
  @@index([vehicleId])
  @@index([createdAt])
  @@map("spare_parts")
}

model DeleteRequest {
  id              String   @id @default(cuid())
  tenantId        String?  @map("tenant_id")
  tenant          Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  assetId         String   @map("asset_id")
  assetType       String   @map("asset_type") // FURNITURE, ELECTRONIC, VEHICLE
  assetName       String   @map("asset_name")
  requestedById   String   @map("requested_by_id")
  reason          String?
  status          String @default("PENDING")
  reviewedById    String?  @map("reviewed_by_id")
  reviewNotes     String?  @map("review_notes")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  requestedBy     User     @relation("DeleteRequestUser", fields: [requestedById], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([assetId])
  @@index([assetType])
  @@index([status])
  @@index([requestedById])
  @@index([createdAt])
  @@map("delete_requests")
}

model UserCreationRequest {
  id              String   @id @default(cuid())
  tenantId        String?  @map("tenant_id")
  tenant          Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  fullName        String   @map("full_name")
  email           String
  role            String     @default("VIEW_USER")
  department      String?
  designation     String?
  phone           String?
  requestedById   String   @map("requested_by_id")
  reason          String?
  status          String @default("PENDING")
  reviewedById    String?  @map("reviewed_by_id")
  reviewNotes     String?  @map("review_notes")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  requestedBy     User     @relation("UserCreationRequestUser", fields: [requestedById], references: [id], onDelete: Cascade)

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([status])
  @@index([requestedById])
  @@index([createdAt])
  @@map("user_creation_requests")
}

model UserDeleteRequest {
