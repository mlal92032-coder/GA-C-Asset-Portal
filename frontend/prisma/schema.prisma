// ============= UNIFIED SETTINGS SYSTEM =============

model SettingCategory {
  id            String   @id @default(cuid())
  tenantId      String?  @map("tenant_id")
  tenant        Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name          String
  slug          String
  description   String?
  icon          String   // Icon name from lucide-react
  color         String   // text color class
  bgColor       String   // background gradient class
  order         Int      @default(0)
  isSystem      Boolean  @default(false) // Cannot be deleted if true
  requiredRole  String     @default("SUPER_ADMIN") // Minimum role to access
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  settings      SystemSetting[]

  @@unique([tenantId, name])
  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("setting_categories")
}

model SystemSetting {
  id              String   @id @default(cuid())
  tenantId        String?  @map("tenant_id")
  tenant          Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  categoryId      String   @map("category_id")
  category        SettingCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  key             String   // e.g., "organizationName"
  displayName     String   // e.g., "Organization Name"
  description     String?
  value           String?  // Stored as JSON for complex types
  dataType        String   @default("string") // string, number, boolean, json, email, url
  fieldType       String   @default("text") // text, textarea, number, email, color, select, checkbox, date, time, phone, url
  validation      String?  // e.g., "required, email"
  options         String?  // For select/radio: JSON array
  placeholder     String?
  helpText        String?
  isEncrypted     Boolean  @default(false) // For passwords, API keys
  isRequired      Boolean  @default(false)
  order           Int      @default(0)
  isActive        Boolean  @default(true)
  isVisible       Boolean  @default(true) // Can be hidden from UI

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  auditLogs       SettingAuditLog[]

  @@unique([tenantId, categoryId, key])
  @@index([tenantId])
  @@index([categoryId])
  @@map("system_settings")
}

model SettingAuditLog {
  id              String   @id @default(cuid())
  userId          String   @map("user_id")
  user            User     @relation("SettingsAuditUser", fields: [userId], references: [id], onDelete: Cascade)

  settingId       String   @map("setting_id")
  setting         SystemSetting @relation(fields: [settingId], references: [id], onDelete: Cascade)

  categoryName    String
  fieldName       String
  oldValue        String?
  newValue        String?
  changeReason    String?
  ipAddress       String?
  userAgent       String?

  createdAt       DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([settingId])
  @@index([createdAt])
  @@map("setting_audit_logs")
}

model SecurityPolicy {
  id                      String   @id @default(cuid())
  tenantId                String   @unique @map("tenant_id")
  tenant                  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Authentication
  sessionTimeoutMinutes   Int      @default(30)
  maxLoginAttempts        Int      @default(5)
  lockoutDurationMinutes  Int      @default(15)
  passwordExpiryDays      Int      @default(90)
  passwordHistoryCount    Int      @default(5) // Can't reuse last N passwords
  minPasswordLength       Int      @default(8)
  requirePasswordUppercase Boolean @default(true)
  requirePasswordNumbers   Boolean @default(true)
  requirePasswordSpecial   Boolean @default(true)
  require2FA              Boolean @default(false)
  allow2FABypass          Boolean @default(false) // Recovery codes

  // IP Restrictions
  enableIPRestriction     Boolean @default(false)
  allowedIPs              String?  // JSON array of IPs

  // API Settings
  enableAPIAccess         Boolean @default(true)
  apiRateLimitPerMinute   Int     @default(100)
  apiKeyRotationDays      Int     @default(90)

  // Audit & Logging
  enableAuditLogging      Boolean @default(true)
  logSensitiveActions     Boolean @default(true)
  auditLogRetentionDays   Int     @default(365)

  // Data Privacy
  enableGDPRMode          Boolean @default(true)
  dataRetentionYears      Int     @default(7)
  autoDeleteOldRecords    Boolean @default(false)
  encryptSensitiveFields  Boolean @default(true)

  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  @@map("security_policies")
}

model NotificationPreference {
  id                      String   @id @default(cuid())
  tenantId                String   @map("tenant_id")
  tenant                  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  userId                  String?  @unique @map("user_id")
  user                    User?    @relation("NotificationPref", fields: [userId], references: [id], onDelete: Cascade)

  // Email Settings
  emailNotificationsEnabled  Boolean @default(true)
  emailAddress            String?
  emailFrequency          String   @default("REALTIME") // REALTIME, DAILY, WEEKLY

  // In-App Settings
  inAppNotificationsEnabled  Boolean @default(true)
  soundEnabled            Boolean @default(true) // Bell sound
  soundVolume             Int     @default(50) // 0-100
  desktopNotificationsEnabled Boolean @default(true)

  // Alert Types (JSON)
  alertTypes              String?  // {"assetAdded": true, "checkout": true, ...}

  // Thresholds
  maintenanceAlertDays    Int     @default(7)
  warrantyAlertDays       Int     @default(30)
  stockLevelAlertThreshold Int    @default(10)
  budgetVarianceAlertPercent Int  @default(10)
  overdueCheckoutAlertDays Int    @default(3)

  // Quiet Hours
  quietHoursEnabled       Boolean @default(false)
  quietHoursStart         String? // "18:00"
  quietHoursEnd           String? // "09:00"

  // Notification Retention
  retentionDays           Int     @default(30)
  autoDeleteNotifications Boolean @default(true)

  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, userId])
  @@index([tenantId])
  @@index([userId])
  @@map("notification_preferences")
}

model RolePermission {
  id              String   @id @default(cuid())
  role            String
  module          String   // dashboard, furniture, electronics, vehicles, users, reports, settings, audit_logs
  action          String   // view, create, edit, delete, export, import, approve, reject, checkout, checkin
  isAllowed       Boolean  @default(true)

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([role, module, action])
  @@map("role_permissions")
}

model UserPermissionOverride {
  id              String   @id @default(cuid())
  tenantId        String?  @map("tenant_id")
  tenant          Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  userId          String   @map("user_id")
  user            User     @relation("PermissionOverrides", fields: [userId], references: [id], onDelete: Cascade)

  module          String   // Module name
  action          String   // Action name
  isAllowed       Boolean  @default(true) // Override to allow/deny

  validFrom       DateTime @default(now()) @map("valid_from")
  validUntil      DateTime? @map("valid_until")
  reason          String?

  appliedBy       String   @map("applied_by")
