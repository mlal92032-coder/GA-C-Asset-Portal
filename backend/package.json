{
  "name": "asset-management-backend",
  "version": "1.0.1",
  "description": "Backend - Node.js API Server",
  "scripts": {
    "dev": "node -r ts-node/register src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "eslint src --ext .ts",
    "test": "jest",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "ws": "node -r ts-node/register src/websocket/server.ts",
    "jobs": "node -r ts-node/register src/jobs/worker.ts"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.3.0",
    "@slack/web-api": "^6.9.0",
    "axios": "^1.6.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.0.0",
    "cors": "^2.8.5",
    "decimal.js": "^10.4.3",
    "helmet": "^7.0.0",
    "ioredis": "^5.3.0",
    "jsonwebtoken": "^9.0.2",
    "lodash": "^4.17.21",
    "next": "^14.0.0",
    "next-auth": "^4.24.15",
    "nodemailer": "^6.9.7",
    "pdfkit": "^0.13.0",
    "socket.io": "^4.7.0",
    "speakeasy": "^2.0.0",
    "twilio": "^4.10.0",
    "uuid": "^9.0.0",
    "xlsx": "^0.18.5",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.8.0",
    "@types/nodemailer": "^6.4.14",
    "eslint": "^8.51.0",
    "jest": "^29.7.0",
    "prisma": "^5.3.0",
    "supertest": "^6.3.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.2.0"
  }
}
