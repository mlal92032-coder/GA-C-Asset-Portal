# Database - PostgreSQL (Production/Private Server)
DATABASE_URL="postgresql://postgres:password@your-db-host:5432/asset_management"
PGBOUNCER_URL="postgresql://postgres:password@your-pgbouncer-host:6432/asset_management"

# Redis Cache (for private server)
REDIS_URL="redis://localhost:6379"

# NextAuth Configuration
NEXTAUTH_SECRET="/rr9d2QqLfYl5aJKYiigluQcYZrW9iIo9yiiuS52d8M="
NEXTAUTH_URL="https://your-domain.com"

# Public URLs
NEXT_PUBLIC_BASE_URL="https://your-domain.com"
NEXT_PUBLIC_API_URL="https://your-domain.com/api"

# Environment
NODE_ENV="production"

# Email Configuration
EMAIL_FROM="noreply@assetmanagement.com"
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=465
SMTP_USER=""
SMTP_PASSWORD=""

# Twilio SMS Configuration
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# Slack Integration Configuration
SLACK_BOT_TOKEN=""
SLACK_SIGNING_SECRET=""

# Redis Configuration for Job Queues
REDIS_HOST="localhost"
REDIS_PORT=6379

# Security
JWT_SECRET="/rr9d2QqLfYl5aJKYiigluQcYZrW9iIo9yiiuS52d8M="
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN="7d"

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_DIR="./public/uploads"

# Logging
LOG_LEVEL="info"

# ✅ FEATURE FLAGS FOR PRIVATE SERVER (ALL ENABLED)
ENABLE_BACKGROUND_JOBS=true
ENABLE_WEBSOCKET=true
ENABLE_EMAIL_QUEUE=true

